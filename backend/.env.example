# Project Neuron - Environment Variables
# For local SQLite testing (default if PostgreSQL is not running):
# DATABASE_URL=sqlite:///./neuron.db

# For PostgreSQL (local or cloud like Neon.tech / Supabase / Railway):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neuron_db

# Frontend URLs for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173,https://project-neuron.vercel.app

# Real LLM API Key (Supports Groq / Gemini / OpenAI):
# Option A: Groq (Recommended - Free & Fast: https://console.groq.com)
AI_API_KEY=gsk_your_groq_api_key_here
# Option B: OpenAI
# AI_API_KEY=sk-your_openai_key_here
# Option C: Gemini
# AI_API_KEY=AIzaSy_your_gemini_key_here
